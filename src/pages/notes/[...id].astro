---
import { getCollection, render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
export async function getStaticPaths() {
  const entries = await getCollection('notes', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<ContentLayout title={entry.data.title} description={entry.data.description} eyebrow={`${entry.data.category} · ${entry.data.publishedAt.toLocaleDateString('ko-KR')}`}>
  <ul class="tags">{entry.data.tags.map((item: string) => <li>{item}</li>)}</ul>
  <Content />
</ContentLayout>
