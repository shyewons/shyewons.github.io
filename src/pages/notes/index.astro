---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteCard from '../../components/NoteCard.astro';
const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---
<BaseLayout title="Dev Notes" description="오류 해결, 기술 선택, 프로젝트와 연결된 학습 기록">
  <section class="page-hero section"><p class="eyebrow">DEV NOTES</p><h1>해결책뿐 아니라<br />원인을 찾은 과정을 기록합니다.</h1><p>트러블슈팅, 기술 비교와 선택, 실제 구현과 연결된 개념을 정리합니다.</p></section>
  <section class="section">{notes.length ? <div>{notes.map((note) => <NoteCard note={note} />)}</div> : <div class="empty"><h2>Dev Notes 작성 예정</h2><p>첫 번째 문제 해결 기록이 준비되면 이 페이지에 공개됩니다.</p></div>}</section>
</BaseLayout>
