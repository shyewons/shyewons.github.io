---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NoteCard from '../components/NoteCard.astro';
import { site, skills } from '../data/site';

const projects = (await getCollection('projects', ({ data }) => !data.draft && data.featured)).slice(0, 3);
const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()).slice(0, 3);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout>
  <section class="hero section">
    <p class="eyebrow">AI × WEB SERVICE DEVELOPER</p>
    <h1>화면에서 데이터,<br /><span>운영까지 연결합니다.</span></h1>
    <p class="hero-copy">{site.description}</p>
    <div class="actions"><a class="button primary" href={`${base}/projects/`}>프로젝트 보기</a><a class="button" href={`${base}/about/`}>더 알아보기</a></div>
  </section>

  <section class="section intro-grid">
    <div><p class="eyebrow">WHAT I DO</p><h2>기술보다<br />구현한 경험을 말합니다.</h2></div>
    <div class="skill-list">{skills.map(({ group, items }) => <div><h3>{group}</h3><p>{items.join(' · ')}</p></div>)}</div>
  </section>

  <section class="section">
    <div class="section-heading"><div><p class="eyebrow">SELECTED WORK</p><h2>대표 프로젝트</h2></div><a class="text-link" href={`${base}/projects/`}>전체 보기 →</a></div>
    {projects.length ? <div class="card-grid">{projects.map((project) => <ProjectCard project={project} />)}</div> : <div class="empty"><h3>프로젝트를 정리하고 있습니다.</h3><p><code>src/content/projects</code>에 Markdown 파일을 추가하면 이곳에 표시됩니다.</p></div>}
  </section>

  <section class="section notes-preview">
    <div class="section-heading"><div><p class="eyebrow">DEV NOTES</p><h2>문제를 좁히고,<br />과정을 기록합니다.</h2></div><a class="text-link" href={`${base}/notes/`}>전체 보기 →</a></div>
    {notes.length ? <div>{notes.map((note) => <NoteCard note={note} />)}</div> : <div class="empty"><h3>첫 번째 기록을 준비하고 있습니다.</h3><p>문제 상황, 원인 분석, 선택 근거와 결과를 중심으로 기록합니다.</p></div>}
  </section>
</BaseLayout>
