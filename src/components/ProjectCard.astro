---
const { project } = Astro.props;
const { title, description, period, type, role, stack } = project.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<article class="card project-card">
  <div class="card-top"><span>{period}</span><span>{type}</span></div>
  <h3><a href={`${base}/projects/${project.id}/`}>{title}</a></h3>
  <p>{description}</p>
  <p class="role">{role}</p>
  <ul class="tags" aria-label="기술 스택">{stack.map((item: string) => <li>{item}</li>)}</ul>
  <a class="text-link" href={`${base}/projects/${project.id}/`}>프로젝트 보기 →</a>
</article>
